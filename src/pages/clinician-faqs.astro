---
import Base from '../layouts/Base.astro';
import PageHead from '../components/page/PageHead.astro';
import Cta from '../components/page/Cta.astro';
import Faqs from '../components/page/Faqs.astro';
import { clinicianFaqs as items } from '../data/faqs';
import { routes, site } from '../data/site';

const title = 'Clinician questions about Pelvy, answered';
const description = 'What Pelvy costs a clinic, how long patients get it free, whether it works with clinical software, and how to subscribe.';
const schema = [{
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') } })),
}];
---
<Base {title} {description} {schema} crumbs={[{ name: 'Questions from clinicians', href: routes.clinicianFaqs }]}>
  <PageHead kicker="Questions from clinicians" title="What clinics ask before they subscribe." lead="What Pelvy does, what it costs and what it doesn’t do yet." narrow />
  <section class="section--tight">
    <div class="wrap faqs">
      <div data-rise><Faqs {items} /></div>
      <aside class="faqs__aside stack" style="--stack-gap: 0.75rem" data-rise>
        <h2 class="h3">Something else?</h2>
        <p class="body">Email <a href={`mailto:${site.email}`}>{site.email}</a> or <a href={routes.contact}>send Amelia a message</a>. She answers these herself.</p>
        <p><a class="link-strong" href={routes.peopleFaqs}>Questions from patients</a></p>
      </aside>
    </div>
  </section>
  <Cta for="clinic" />
</Base>

<style>
  .faqs { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 1000px) { .faqs { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); } .faqs__aside { position: sticky; top: calc(var(--header-h) + 2rem); } }
  .faqs__aside { background: var(--mint); border-radius: var(--r-panel); padding: 1.75rem; }
</style>
