---
import Base from '../layouts/Base.astro';
import PageHead from '../components/page/PageHead.astro';
import Cta from '../components/page/Cta.astro';
import directory from '../data/clinics.json';
import { routes } from '../data/site';

const clinics = [...directory.clinics].sort((a, b) => a.name.localeCompare(b.name));
// The last part of a location is its country; Australian ones also carry a state.
const STATES = ['QLD', 'NSW', 'VIC', 'WA', 'SA', 'NT', 'TAS', 'ACT'];
const region = (loc: string) => {
  const state = STATES.find((s) => new RegExp(`\\b${s}\\b`).test(loc));
  if (state) return state;
  const last = loc.split(',').pop()!.trim();
  return /Australia/.test(last) ? 'Australia' : last;
};
const withRegion = clinics.map((c) => ({ ...c, region: region(c.location), telehealth: c.tags.includes('Telehealth') }));
const regions = [...new Set(withRegion.map((c) => c.region))].sort((a, b) => (STATES.includes(a) ? 0 : 1) - (STATES.includes(b) ? 0 : 1) || a.localeCompare(b));
const site = (c: (typeof clinics)[number]) => c.links.find((l) => l.title === 'Website')?.href;

const title = 'Clinics that use Pelvy';
const description = `${clinics.length} pelvic health clinics that use Pelvy with their patients, with where they are, what they do and whether they offer telehealth.`;
---
<Base {title} {description} crumbs={[{ name: 'Find a clinic', href: routes.directory }]}>
  <PageHead kicker="Find a clinic" title="Clinics that use Pelvy." lead={`${clinics.length} clinics, as listed in Pelvy’s directory. Each sets its patients up on Pelvy, free for their first six months.`} narrow />

  <section class="section--tight dir" data-directory>
    <div class="wrap">
      <form class="dir__tools" role="search" aria-label="Filter the clinic list" data-dir-tools hidden>
        <div class="field dir__search">
          <label for="dir-q">Search by clinic, place or what they do</label>
          <input id="dir-q" type="search" autocomplete="off" data-dir-q />
        </div>
        <div class="field">
          <label for="dir-region">State or country</label>
          <select id="dir-region" data-dir-region>
            <option value="">Everywhere</option>
            {regions.map((r) => <option value={r}>{r}</option>)}
          </select>
        </div>
        <label class="dir__check"><input type="checkbox" data-dir-tele /> Telehealth only</label>
      </form>
      <p class="dir__count" aria-live="polite" data-dir-count>{clinics.length} clinics</p>
      <!-- Down the list, the search is one press away. Shown by the script once the search has scrolled out of sight. -->
      <button class="dir__back" type="button" data-dir-back title="Back to search" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
        <span>Back to search</span>
      </button>

      <ul class="dir__list" role="list">
        {withRegion.map((c) => (
          <li class="clinic" data-clinic data-region={c.region} data-tele={c.telehealth ? '1' : '0'} data-text={[c.name, c.clinicians, c.location, c.tags.join(' ')].join(' ').toLowerCase()}>
            <div class="clinic__head">
              <h2 class="h3">{c.name}</h2>
              <p class="clinic__who">{c.clinicians}</p>
              <p class="clinic__where">{c.location}</p>
            </div>
            <div class="clinic__body">
              {c.tags.length > 0 && <ul class="clinic__tags" role="list">{c.tags.map((t) => <li class="chip chip--plain">{t}</li>)}</ul>}
              {c.quote && (
                <figure class="clinic__quote">
                  <blockquote>{c.quote}</blockquote>
                  <figcaption>{c.quoteAttribution}</figcaption>
                </figure>
              )}
              {c.details.length > 0 && (
                <details class="clinic__more">
                  <summary>More about this clinic</summary>
                  <dl>{c.details.map((d) => (<div><dt>{d.label}</dt><dd>{d.value}</dd></div>))}</dl>
                </details>
              )}
              {site(c) && <p><a class="link-strong" href={site(c)} rel="noopener">Visit {c.name}<span class="visually-hidden"> (their own website)</span></a></p>}
            </div>
          </li>
        ))}
      </ul>
      <p class="dir__none body" data-dir-none hidden>No clinic matches that. Clear the search, or <a href={routes.contact}>ask Amelia</a> about one near you.</p>
      <p class="fine dir__note">Clinic details and quotes are the clinics’ own, as they appear in Pelvy’s directory on 12 October 2026. Pelvy doesn’t assess or rank clinics.</p>
    </div>
  </section>

  <Cta />
</Base>

<script>
  // Filtering is an extra. With no script the whole list is there.
  const root = document.querySelector<HTMLElement>('[data-directory]');
  if (root) {
    const tools = root.querySelector<HTMLFormElement>('[data-dir-tools]')!;
    const q = root.querySelector<HTMLInputElement>('[data-dir-q]')!;
    const region = root.querySelector<HTMLSelectElement>('[data-dir-region]')!;
    const tele = root.querySelector<HTMLInputElement>('[data-dir-tele]')!;
    const count = root.querySelector<HTMLElement>('[data-dir-count]')!;
    const none = root.querySelector<HTMLElement>('[data-dir-none]')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-clinic]')];
    tools.hidden = false;
    const apply = () => {
      const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((el) => {
        const ok = words.every((w) => el.dataset.text!.includes(w)) && (!region.value || el.dataset.region === region.value) && (!tele.checked || el.dataset.tele === '1');
        el.hidden = !ok;
        if (ok) shown += 1;
      });
      count.textContent = `${shown} ${shown === 1 ? 'clinic' : 'clinics'}`;
      none.hidden = shown > 0;
    };
    tools.addEventListener('input', apply);
    tools.addEventListener('submit', (e) => e.preventDefault());

    // The list is long. Once the search is above the screen, a control that returns to it stays in reach.
    const back = root.querySelector<HTMLButtonElement>('[data-dir-back]')!;
    const list = root.querySelector<HTMLElement>('.dir__list')!;
    let toolsGone = false, listSeen = false;
    const show = () => back.classList.toggle('is-on', toolsGone && listSeen);
    new IntersectionObserver(([en]) => { toolsGone = !en.isIntersecting && en.boundingClientRect.top < 0; show(); }).observe(tools);
    new IntersectionObserver(([en]) => { listSeen = en.isIntersecting; show(); }).observe(list);
    back.hidden = false;
    back.addEventListener('click', () => {
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      tools.scrollIntoView({ block: 'start', behavior: smooth ? 'smooth' : 'auto' });
      q.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .dir__tools { display: grid; gap: 1rem; align-items: end; padding: 1.25rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-panel); }
  /* The filter only shows once the script that runs it is there. */
  .dir__tools[hidden], .dir__back[hidden] { display: none; }
  @media (min-width: 800px) { .dir__tools { grid-template-columns: minmax(0, 1fr) 14rem auto; } }
  .dir__check { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.25rem; font-weight: 600; font-size: var(--text-sm); }
  .dir__check input { width: 1.25rem; height: 1.25rem; accent-color: var(--deep); }
  .dir__count { margin-block: 1.5rem 0.75rem; font-family: var(--stack-mono); font-weight: 500; color: var(--muted); }

  /* It rises 8px into place at the foot of the screen, and leaves the same way. */
  .dir__back {
    position: fixed; z-index: 40; left: 50%; bottom: max(1.25rem, env(safe-area-inset-bottom)); translate: -50% 0;
    display: inline-flex; align-items: center; gap: 0.55rem; min-height: 3rem; padding: 0 1.4rem 0 1.15rem;
    border: 2px solid var(--ink); border-radius: var(--r-pill); background: var(--white); color: var(--ink);
    font-weight: 600; font-size: var(--text-sm); line-height: 1; white-space: nowrap; cursor: pointer; box-shadow: var(--shadow-md);
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity 320ms var(--settle-ease), transform var(--breath-ms) var(--breath-ease), visibility 0s linear 320ms, background-color var(--duration-base) var(--ease-standard), color var(--duration-base) var(--ease-standard);
  }
  .dir__back.is-on { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .dir__back:hover { background: var(--ink); color: var(--white); }
  .dir__back svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* On a wide screen it is a round control in the page's right margin, so it never covers the list. */
  @media (min-width: 1200px) {
    .dir__back {
      --edge: max(var(--pad), calc((100vw - var(--wrap)) / 2));
      left: auto; right: max(0.375rem, calc(var(--edge) - 3.75rem)); translate: none;
      width: 3rem; height: 3rem; padding: 0; justify-content: center;
    }
    .dir__back span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) { .dir__back { transform: none; transition: none; } }

  .dir__list { margin: 0; border-top: 2px solid var(--ink); }
  .clinic { display: grid; gap: 1rem 3rem; padding-block: clamp(1.5rem, 3vw, 2.25rem); border-bottom: 1px solid var(--line); }
  .clinic[hidden] { display: none; }
  @media (min-width: 900px) { .clinic { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); } }
  .clinic__head { display: grid; gap: 0.25rem; align-content: start; }
  .clinic__who { font-weight: 500; }
  .clinic__where { color: var(--muted); font-size: var(--text-sm); }
  .clinic__body { display: grid; gap: 1rem; min-width: 0; }
  .clinic__tags { margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .clinic__quote { margin: 0; padding: 1.1rem 1.4rem; background: var(--mint); border-radius: var(--r-panel); display: grid; gap: 0.6rem; }
  .clinic__quote blockquote { font-family: var(--stack-display); font-weight: 500; font-size: var(--text-md); line-height: 1.34; }
  .clinic__quote figcaption { font-size: var(--text-sm); font-weight: 600; }
  .clinic__more summary { cursor: pointer; font-weight: 600; font-size: var(--text-sm); color: var(--deep); padding-block: 0.4rem; width: fit-content; }
  .clinic__more dl { margin: 0.75rem 0 0; display: grid; gap: 0.75rem; font-size: var(--text-sm); max-width: var(--measure); }
  .clinic__more dt { font-weight: 600; }
  .clinic__more dd { margin: 0; color: var(--ink); }
  .dir__none { margin-top: 2rem; }
  .dir__note { margin-top: 2rem; max-width: 70ch; }
</style>
