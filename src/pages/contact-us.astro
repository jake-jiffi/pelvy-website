---
import Base from '../layouts/Base.astro';
import PageHead from '../components/page/PageHead.astro';
import Form from '../components/page/Form.astro';
import { routes, site } from '../data/site';

const title = 'Contact Amelia at Pelvy';
const description = 'Ask a question about Pelvy or get help with the app. Amelia, Pelvy’s founder, answers these herself.';
---
<Base {title} {description} crumbs={[{ name: 'Contact', href: routes.contact }]}>
  <PageHead kicker="Contact" title="Ask Amelia." lead="A question about Pelvy, or help with the app. She answers these herself." narrow />
  <section class="section--tight">
    <div class="wrap contact">
      <div data-rise>
        <Form subject="Pelvy website enquiry" submit="Write my email">
          <div class="form__row">
            <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" autocomplete="name" required /></div>
            <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required /></div>
          </div>
          <div class="form__row">
            <div class="field"><label for="c-phone">Phone (optional)</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" /></div>
            <div class="field"><label for="c-country">Country</label><input id="c-country" name="country" autocomplete="country-name" required /></div>
          </div>
          <fieldset>
            <legend>What is it about?</legend>
            <label class="choice"><input type="radio" name="about" value="A question about Pelvy" data-label="About" checked /> A question about Pelvy</label>
            <label class="choice"><input type="radio" name="about" value="Help with the app" data-label="About" /> Help with the app</label>
          </fieldset>
          <div class="field"><label for="c-message">Your message</label><textarea id="c-message" name="message" maxlength="1500" required></textarea></div>
        </Form>
      </div>
      <aside class="contact__aside stack" style="--stack-gap: 1rem; --i: 1" data-rise>
        <h2 class="h3">Or directly</h2>
        <p><a class="link-strong" href={`mailto:${site.email}`}>{site.email}</a><br /><a href={site.phoneHref}>{site.phone}</a></p>
        <p class="small">{site.legalName}<br />{site.address}</p>
        <p class="small">If something hurts or your symptoms are worse, stop the program and see a pelvic health physio. Pelvy can’t assess anyone, and neither can this form.</p>
        <p><a class="link-strong" href={routes.signUp}>A clinician? Book a demo instead</a></p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: clamp(2rem, 6vw, 5rem); align-items: start; padding-bottom: var(--section); }
  @media (min-width: 1000px) { .contact { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); } }
  .contact__aside { background: var(--mint); border-radius: var(--r-panel); padding: 1.75rem; }
</style>
