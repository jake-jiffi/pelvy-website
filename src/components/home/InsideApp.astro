---
// The app's home screen, on the ground the app always sits on. Only large type
// goes straight onto sage; the reading-size list has its own white panel.
import AppHub from '../AppHub.astro';
---
<section class="inside ground" data-ground aria-labelledby="inside-title">
  <div class="wrap inside__grid">
    <div class="inside__head">
      <h2 class="h1" id="inside-title" data-rise>Three tabs, and nothing to dig for.</h2>
      <p class="inside__lead" data-rise style="--i: 1">This is the app’s home screen.<span class="inside__tap"> Tap the tabs.</span></p>
    </div>

    <div class="inside__stage" data-rise style="--i: 1">
      <div class="inside__screen"><AppHub /></div>
    </div>

    <ol class="inside__list" role="list" data-rise style="--i: 2">
      <li>
        <button type="button" class="inside__item" data-hub-go="programs" aria-pressed="true">
          <span class="inside__name serif">Programs</span>
          <span class="inside__text">Three ship with the app: one for strength, one for letting go, and one that teaches the timing between the two. Your clinician can add their own.</span>
        </button>
      </li>
      <li>
        <button type="button" class="inside__item" data-hub-go="videos" aria-pressed="false">
          <span class="inside__name serif">Videos</span>
          <span class="inside__text">Mobility and stretches for hips, lower back and upper back, filmed with real people, including men. Each one shows a supported version and one with movement.</span>
        </button>
      </li>
      <li>
        <button type="button" class="inside__item" data-hub-go="learn" aria-pressed="false">
          <span class="inside__name serif">Learn</span>
          <span class="inside__text">Five articles, in order, that help you work out whether you need to strengthen or to relax. Each one says it is general education, not individual advice.</span>
        </button>
      </li>
    </ol>
  </div>
</section>

<style>
  .inside { background: var(--sage); color: var(--ink); }
  /* On a phone: the heading, the screen with its instruction, then the list. */
  .inside__grid { display: grid; gap: clamp(1.75rem, 5vw, 2.5rem); padding-block: var(--section); }
  .inside__head { display: grid; gap: 1rem; min-width: 0; }
  .inside__head :global(.h1) { max-width: 13ch; }
  /* Ink sits on sage at 24px and up, never smaller. */
  .inside__lead { font-size: max(1.5rem, var(--text-md)); line-height: 1.3; }
  .inside__stage { min-width: 0; }
  .inside__screen { width: min(100%, 20.5rem); margin-inline: auto; }

  .inside__list { margin: 0; min-width: 0; background: var(--white); border-radius: var(--r-panel); padding: 0.35rem clamp(1.1rem, 2.4vw, 1.75rem); }
  .inside__list li + li { border-top: 1px solid var(--line); }
  .inside__item {
    appearance: none; width: 100%; text-align: left; background: none; border: 0; cursor: pointer;
    display: grid; gap: 0.35rem; padding: 1.25rem 0 1.25rem 1.5rem; position: relative; color: inherit;
  }
  .inside__item::before {
    content: ''; position: absolute; left: 0; top: 1.25rem; bottom: 1.25rem; width: 4px; border-radius: var(--r-pill);
    background: var(--line); transition: background-color var(--breath-ms) var(--ease-standard);
  }
  .inside__item[aria-pressed='true']::before { background: var(--deep); }
  .inside__name { font-weight: 600; font-size: var(--text-md); line-height: 1.2; }
  .inside__text { max-width: 46ch; color: var(--muted); transition: color var(--breath-ms) var(--ease-standard); }
  .inside__item[aria-pressed='true'] .inside__text, .inside__item:hover .inside__text { color: var(--ink); }

  @media (min-width: 900px) {
    .inside__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-rows: auto 1fr;
      grid-template-areas: 'stage head' 'stage list'; gap: 2rem clamp(2rem, 6vw, 6rem); align-items: start;
    }
    .inside__stage { grid-area: stage; align-self: center; }
    .inside__head { grid-area: head; }
    .inside__head :global(.h1) { max-width: 16ch; }
    .inside__list { grid-area: list; }
  }

  /* With no script the screen shows Programs, the list is plain reading and nothing says to tap. */
  :global(html:not(.js)) .inside__item { cursor: default; }
  :global(html:not(.js)) .inside__tap { display: none; }
</style>
