---
// Two things a handout can't do, each shown before it is explained. First the
// clinician's note, on a soft sage ground that slides up over the handout
// scene (the heading is at the end of Handout.astro) and holds the biggest
// words on the page. Then the program card, counting.
import NoteCard from '../NoteCard.astro';
import ProgramCount from '../ProgramCount.astro';
---
<section class="voice ground" data-ground aria-label="A sample of a clinician’s note">
  <div class="wrap voice__in">
    <NoteCard
      from={false}
      reading
      words="Let your belly go, then belly breathing. Use your guided program."
      by="Amelia Godfrey, pelvic health physiotherapist"
    />
  </div>
</section>

<section class="things" aria-labelledby="two-title">
  <div class="wrap">
    <div class="caption" data-rise>
      <h3 class="h2">It keeps what they said.</h3>
      <div class="caption__text">
        <p class="body">When your clinic subscribes, your clinician writes their advice into Pelvy. It’s the first thing you see each time you open the app, and it’s still there in three months, when the handout isn’t.</p>
        <p class="fine">The note shown is a sample from Pelvy’s store listing.</p>
      </div>
    </div>

    <ProgramCount />

    <div class="caption caption--after" data-rise>
      <h3 class="h2">It counts, and it reminds.</h3>
      <div class="caption__text">
        <p class="body">Pelvy counts every rep and every hold of the whole program, so nobody stops halfway because they lost count. Each program takes up to three reminders a day, at the times you choose.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- The note: the ground is the card ---------- */

  .voice { background: var(--sage-soft); color: var(--ink); }
  .voice__in { display: grid; align-content: center; min-height: min(78svh, 58rem); padding-block: clamp(4.5rem, 11vw, 8rem); }
  .voice :global(.note) { background: none; border-radius: 0; padding: 0; gap: clamp(1.75rem, 3.6vw, 2.75rem); }
  /* The biggest words on the page: larger than the opening headline at every width. */
  .voice :global(.note__words) {
    font-size: clamp(2.8rem, 1.5rem + 5.6vw, 6rem); line-height: 1.06; letter-spacing: -0.026em;
    max-width: 13.5em; text-wrap: balance;
  }
  .voice :global(.note__by) { font-size: var(--text-md); line-height: 1.3; }

  /* ---------- What each one is, said under it ---------- */

  .things { padding-block: clamp(2.25rem, 4.5vw, 3.5rem) var(--section); }
  .caption { display: grid; gap: 0.9rem clamp(2rem, 6vw, 6rem); align-items: start; }
  .caption__text { display: grid; gap: 0.75rem; }
  .caption--after { margin-top: clamp(1.75rem, 3.6vw, 2.75rem); }
  @media (min-width: 900px) {
    .voice__in { min-height: min(88svh, 58rem); }
    .caption { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .caption__text { padding-top: 0.55rem; }
  }

  /* ---------- The program card, counting ---------- */

  .things :global(.count) { margin-top: clamp(4.5rem, 10vw, 8rem); }
</style>
